{
  "kind": "collectionType",
  "collectionName": "designs",
  "info": {
    "singularName": "design",
    "pluralName": "designs",
    "displayName": "Design",
    "description": "Innendesign je Modellreihe, Außendesign gilt für alle Mobilheime eines Herstellers"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titel": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "titel"
    },
    "bereich": {
      "type": "enumeration",
      "enum": [
        "Innendesign",
        "Aussendesign"
      ],
      "default": "Innendesign",
      "required": true
    },
    "kurzbeschreibung": {
      "type": "text"
    },
    "reihenfolge": {
      "type": "integer",
      "default": 0
    },
    "hersteller": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::hersteller.hersteller",
      "inversedBy": "designs"
    },
    "modellreihen": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::modellreihe.modellreihe",
      "inversedBy": "designs"
    },
    "inhalt": {
      "type": "dynamiczone",
      "components": [
        "design.beschreibung",
        "design.vorhang",
        "design.sofa",
        "design.galerie",
        "design.details"
      ]
    }
  }
}
