{
  "kind": "collectionType",
  "collectionName": "gelaendermodelle",
  "info": {
    "singularName": "gelaendermodell",
    "pluralName": "gelaendermodelle",
    "displayName": "Geländer",
    "description": "Geländer-Modelle (Casa, Pyla, Ola …) – einmal anlegen, auf Terrassen-Seiten per „Geländer-Auswahl“ wiederverwenden"
