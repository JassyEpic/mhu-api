      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "beschreibung": {
      "type": "string"
    },
    "bild": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "neu": {
      "type": "boolean",
      "default": false
    },
    "reihenfolge": {
      "type": "integer",
      "default": 0
    }
  }
}
