{
  "kind": "collectionType",
  "collectionName": "konfiguratoren",
  "info": {
    "singularName": "konfigurator",
    "pluralName": "konfiguratoren",
    "displayName": "Konfigurator",
    "description": "Farb-Konfigurator eines Mobilheims: Ansichten (Dachvarianten, Innenraum) mit Bild-Ebenen. Import: npm run import:konfigurator"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titel": {
      "type": "string",
      "required": true
    },
    "mobilheim": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::mobilheim.mobilheim",
      "inversedBy": "konfigurator"
    },
    "quelle": {
      "type": "string"
    },
    "hinweis": {
      "type": "text",
      "default": "Die Darstellung ist unverbindlich – Farben und Materialien können in Wirklichkeit abweichen."
    },
    "ansichten": {
      "type": "component",
      "component": "konfigurator.ansicht",
      "repeatable": true
    }
  }
}
