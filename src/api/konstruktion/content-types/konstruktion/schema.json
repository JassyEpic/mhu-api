{
  "kind": "collectionType",
  "collectionName": "konstruktionen",
  "info": {
    "singularName": "konstruktion",
    "pluralName": "konstruktionen",
    "displayName": "Konstruktion",
    "description": "Bauweise & Materialien je Hersteller; ohne Modellreihe gilt ein Eintrag für alle Modelle"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titel": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "titel"
    },
    "kurzbeschreibung": {
      "type": "text"
    },
    "reihenfolge": {
      "type": "integer",
      "default": 0
    },
    "hersteller": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::hersteller.hersteller",
      "inversedBy": "konstruktionen"
    },
    "modellreihen": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::modellreihe.modellreihe",
      "inversedBy": "konstruktionen"
    },
    "inhalt": {
      "type": "dynamiczone",
      "components": [
        "konstruktion.text-block",
        "konstruktion.gallerie",
        "design.details",
        "konstruktion.list"
      ]
    }
  }
}
